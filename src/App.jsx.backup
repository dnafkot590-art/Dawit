    }));
    setDb(p => ({ ...p, expenseEntries: [...expenses, ...p.expenseEntries] }));
    showToast("success", `${emps.length} ßê░ßê½ßë░ßè₧ßë╜ ßè¡ßììßï½ ßë░ßìêßî╜ßêƒßêìßìó`);
