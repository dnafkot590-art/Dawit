      [key]: (p[key] || []).map(e => e.id === entryId ? { ...e, status: "Approved", approvedDate: today() } : e),
    }));
    showToast("success", "ßï¿ßï╢ßè¡ßë░ßê¡ ßê│ßê¥ßèòßë│ßïè ßè¡ßììßï½ ßë░ßìêßëàßï╖ßêìßìó");
  };

