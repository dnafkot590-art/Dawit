                                    ? <input type="number" className="leave-input" style={{ width: 70 }} value={ed.duty ?? (e.duty || 0)} onChange={ev => setPayrollEdit(p => ({ ...p, [e.id]: { ...p[e.id], duty: ev.target.value } }))} />
                                    : `${(e.duty || 0).toLocaleString()}`
                                  }
