                            <option value="">ßê░ßê½ßë░ßè¢ ßê¥ßê¿ßîÑ</option>
                            {(db.employees || []).filter(e2 => e2.id !== emp.id).map(e2 => (
                              <option key={e2.id} value={e2.id}>{e2.name} ΓÇö {e2.department}</option>
