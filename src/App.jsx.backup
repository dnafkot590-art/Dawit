                          value={empMsgBody}
                          onChange={e => setEmpMsgBody(e.target.value)}
                          style={{ width: "100%", minHeight: 80, padding: "8px 12px", borderRadius: 8, border: "1px solid #cbd5e1", fontSize: 14, resize: "vertical" }}
                          required
