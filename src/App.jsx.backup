                                <td>{r.reason}</td>
                                <td>{r.lastDay}</td>
                                <td><span className={`status-badge ${r.status === "Acknowledged" ? "approved" : "pending"}`}>{r.status === "Acknowledged" ? "Γ£à ßë░ßëÇßëáßêê" : "ΓÅ│ Pending"}</span></td>
