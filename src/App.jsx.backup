                                      <input placeholder="ßê¥ßè¡ßèòßï½ßë╡..." className="leave-input" style={{ width: 100, marginTop: 2 }} value={rejectR} onChange={ev => setLeaveRejectReason(p => ({ ...p, [r.id]: ev.target.value }))} />
                                      <button className="btn-danger btn-sm" onClick={() => rejectLeaveWithReason(r.id)}>Γ¥î ßê░ßê¡ßï¥</button>
                                    </div>
                                  )}
                                  <button className="btn-danger btn-sm" style={{ marginTop: r.status === "Pending" ? 4 : 0 }} onClick={() => deleteLeaveRequest(r.id)}>≡ƒùæ∩╕Å</button>
