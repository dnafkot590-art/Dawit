                                  <label>≡ƒÆ╡ ßï¿ßèóßê£ßîéßèòßîì ßïïßîï (Birr)</label>
                                  <input type="number" placeholder="0.00" value={f.imagingPrice} onChange={ev => setDoctorField(emp.id, "imagingPrice", ev.target.value)} />
                                </div>
