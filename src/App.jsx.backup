                    <p style={{ fontSize: 13, color: "#64748b", margin: "0 0 14px" }}>
                      ΓÜá∩╕Å ßï¿ßê╡ßê½ ßêìßëÇßëâ ßëÇßèò ßëóßï½ßèòßê╡ ßè¿ßï¢ßê¼ 30 ßëÇßèò ßëáßèïßêï ßêÿßêåßèò ßèáßêêßëáßë╡ßìó
                    </p>
                    {/* Check if already has pending/acknowledged resignation */}
                    {(db.resignations || []).some(r => r.empId === emp.id && r.status === "Pending") ? (
                      <div style={{ padding: "14px 18px", borderRadius: 12, background: "#fef3c7", border: "1px solid #fde68a" }}>
                        <strong>ΓÅ│ ßîÑßï½ßëäßïÄ ßêê Admin ßë░ßêìßè│ßêìßìó ßëÇßîúßï¡ ßïëßê│ßèö ßï¡ßîáßëÑßëüßìó</strong>
                      </div>
                    ) : (
                      <form className="form-grid" onSubmit={submitResignation}>
                        <textarea
                          placeholder="ßï¿ßê¥ßë╡ßêêßëüßëáßë╡ ßê¥ßè¡ßèòßï½ßë╡ *"
