                    {(db.announcements || []).length === 0
                      ? <p style={{ color: "#94a3b8", fontSize: 13 }}>ßê¥ßèòßê¥ ßê¢ßê╡ßë│ßïêßëéßï½ ßï¿ßêêßê¥ßìó</p>
                      : <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
