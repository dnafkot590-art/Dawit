                  </form>

                  <h4 style={{ margin: "20px 0 10px" }}>Portal Access ßï½ßêïßë╕ßïì ßê░ßê½ßë░ßè₧ßë╜</h4>
                  <table className="report-table">
                    <thead><tr><th>ßê╡ßê¥</th><th>ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡</th><th>Access</th><th>ßï╡ßê¡ßîèßë╡</th></tr></thead>
                    <tbody>
                      {(db.employees || []).length === 0
                        ? <tr><td colSpan={4} style={{ textAlign: "center", color: "#94a3b8" }}>ßê¥ßèòßê¥ ßê░ßê½ßë░ßè¢ ßèáßêìßë░ßêÿßïÿßîêßëáßê¥ßìó</td></tr>
                        : (db.employees || []).map(e => (
                          <tr key={e.id}>
                            <td>{e.name}</td>
                            <td><span className="dept-badge">{e.department}</span></td>
                            <td>
                              {e.hasPortalAccess
                                ? <span className="status-badge approved">Γ£à Active</span>
                                : <span className="status-badge pending">No Access</span>
                              }
                            </td>
                            <td>
                              {e.hasPortalAccess && (
                                <button className="btn-danger btn-sm" onClick={() => revokeUserAccess(e.id)}>
                                  Γ¥î ßê░ßê¡ßï¥
                                </button>
                              )}
                            </td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>

                {/* Right: Annual leave days management */}
                <div className="card">
                  <h3>≡ƒùô∩╕Å ßèáßêÿßë│ßïè ßììßëâßï╡ ßëÇßèôßë╡ ßèáßê╡ßë░ßï│ßï░ßê¡</h3>
                  <p style={{ margin: "0 0 14px", color: "#64748b", fontSize: 13 }}>
                    ßêêßèÑßï½ßèòßï│ßèòßï▒ ßê░ßê½ßë░ßè¢ ßèáßêÿßë│ßïè ßììßëâßï╡ ßëÇßèôßë╡ ßëÑßï¢ßë╡ ßï¡ßïêßê░ßèòßìó Default: 25 ßëÇßèôßë╡ßìó
                  </p>
                  <form className="form-grid" onSubmit={setEmployeeLeaveDays}>
                    <select value={leaveDaysForm.empId} onChange={e => setLeaveDaysForm(p => ({ ...p, empId: e.target.value }))} required>
                      <option value="">ßê░ßê½ßë░ßè¢ ßê¥ßê¿ßîÑ</option>
                      {(db.employees || []).map(e => (
                        <option key={e.id} value={e.id}>{e.name} (ßèáßêüßèò: {e.totalLeaveDays || 25} ßëÇßèò)</option>
                      ))}
                    </select>
                    <input
                      type="number" min={1} max={365}
                      placeholder="ßëÇßèôßë╡ ßëÑßï¢ßë╡"
                      value={leaveDaysForm.days}
                      onChange={e => setLeaveDaysForm(p => ({ ...p, days: e.target.value }))}
                      required
                    />
                    <button className="btn" type="submit" style={{ gridColumn: "1/-1", marginTop: 0 }}>
                      ≡ƒÆ╛ ßëÇßèôßë╡ ßèáßê╡ßëÇßê¥ßîÑ
                    </button>
                  </form>

                  <h4 style={{ margin: "20px 0 10px" }}>ßê░ßê½ßë░ßè₧ßë╜ ΓÇö ßììßëâßï╡ ßëúßêïßèòßê╡</h4>
                  <table className="report-table">
                    <thead><tr><th>ßê╡ßê¥</th><th>ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡</th><th>ßîáßëàßêïßêï</th><th>ßï¿ßïêßê░ßï▒</th><th>ßï¿ßëÇßê¿</th></tr></thead>
                    <tbody>
                      {(db.employees || []).length === 0
                        ? <tr><td colSpan={5} style={{ textAlign: "center", color: "#94a3b8" }}>ßê¥ßèòßê¥ ßê░ßê½ßë░ßè¢ ßï¿ßêêßê¥ßìó</td></tr>
                        : (db.employees || []).map(e => {
                          const rem = (e.totalLeaveDays || 25) - (e.usedLeaveDays || 0);
                          return (
                            <tr key={e.id}>
                              <td>{e.name}</td>
                              <td><span className="dept-badge">{e.department}</span></td>
                              <td>{e.totalLeaveDays || 25}</td>
                              <td>{e.usedLeaveDays || 0}</td>
                              <td style={{ color: rem < 3 ? "#ef4444" : "#16a34a", fontWeight: 700 }}>
                                {rem}{rem < 3 ? " ΓÜá∩╕Å" : ""}
                              </td>
                            </tr>
                          );
                        })
                      }
                    </tbody>
                  </table>

                  {/* Pending leave requests */}
                  {pendingLeave > 0 && (
                    <>
                      <h4 style={{ margin: "20px 0 10px" }}>≡ƒùô∩╕Å Pending ßììßëâßï╡ ßîÑßï½ßëäßïÄßë╜ <span className="badge">{pendingLeave}</span></h4>
                      <table className="report-table">
                        <thead><tr><th>ßê░ßê½ßë░ßè¢</th><th>ßï¿ßëÇßê¿ ßììßëâßï╡</th><th>ßï¿ßîáßï¿ßëü</th><th>ßï¡ßìêßëÇßï▒ (ßëÇßèôßë╡)</th><th>ßîÇßê¥ßê«</th><th>ßèáßï¡ßèÉßë╡</th><th>ßê¥ßè¡ßèòßï½ßë╡ ßê▓ßëÇßëà</th><th>ßï╡ßê¡ßîèßë╡</th></tr></thead>
                        <tbody>
                          {(db.leaveRequests || []).filter(r => r.status === "Pending").map(r => {
                            const emp = (db.employees || []).find(e => e.id === r.empId);
                            const rem = emp ? (emp.totalLeaveDays || 25) - (emp.usedLeaveDays || 0) : "ΓÇö";
                            const adjDays = leaveApproveEdit[r.id] !== undefined ? leaveApproveEdit[r.id] : r.days;
                            const rejectR = leaveRejectReason[r.id] || "";
                            return (
                              <tr key={r.id}>
                                <td>{emp?.name || r.empId}</td>
                                <td style={{ color: typeof rem === "number" && rem < 5 ? "#ef4444" : "#16a34a", fontWeight: 700 }}>{rem} ßëÇßèò</td>
                                <td>{r.days} ßëÇßèò</td>
                                <td>
                                  <input
                                    type="number" min={1} max={rem}
                                    className="leave-input" style={{ width: 60 }}
                                    value={adjDays}
                                    onChange={ev => setLeaveApproveEdit(p => ({ ...p, [r.id]: ev.target.value }))}
                                  />
                                </td>
                                <td>{r.startDate}</td>
                                <td><span className={`status-badge ${r.leaveType === "emergency" ? "rejected" : "pending"}`}>
                                  {r.leaveType === "emergency" ? "≡ƒÜ¿ Emergency" : "≡ƒùô∩╕Å Annual"}
                                </span></td>
                                <td>
                                  <input
                                    placeholder="ßê¥ßè¡ßèòßï½ßë╡..."
                                    className="leave-input" style={{ width: 120 }}
                                    value={rejectR}
                                    onChange={ev => setLeaveRejectReason(p => ({ ...p, [r.id]: ev.target.value }))}
                                  />
                                </td>
                                <td>
                                  <div style={{ display: "flex", gap: 4 }}>
                                    <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 8px", fontSize: 12, background: "#16a34a" }} onClick={() => approveLeaveAdjusted(r.id)}>Γ£à ßììßëâßï╡ ßê╡ßîÑ</button>
                                    <button className="btn-danger btn-sm" onClick={() => rejectLeaveWithReason(r.id)}>Γ¥î ßê░ßê¡ßï¥</button>
                                    <button className="btn-danger btn-sm" onClick={() => deleteLeaveRequest(r.id)}>≡ƒùæ∩╕Å</button>
                                  </div>
                                </td>
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                    </>
                  )}
                </div>
              </section>
            )
          }
          {/* ===== ANNOUNCEMENTS ===== */}
          {
            section === "Announcements" && (
              <section className="panel-grid">
                <div className="card">
                  <h3>≡ƒôó ßèáßï▓ßê╡ ßê¢ßê╡ßë│ßïêßëéßï½ ßêïßè¡</h3>
                  <p style={{ margin: "0 0 12px", color: "#64748b", fontSize: 13 }}>ßê¢ßê╡ßë│ßïêßëéßï½ ßêêßêüßêëßê¥ ßê░ßê½ßë░ßè₧ßë╜ Portal ßêïßï¡ ßï¡ßë│ßï½ßë╕ßïïßêìßìó</p>
                  <form onSubmit={sendAnnouncement}>
                    <div className="form-grid">
                      <input
                        placeholder="ßê¡ßïòßê╡ (Title)"
                        value={announcementForm.title}
                        onChange={e => setAnnouncementForm(p => ({ ...p, title: e.target.value }))}
                        required
                        style={{ gridColumn: "1/-1" }}
                      />
                      <textarea
                        placeholder="ßï¥ßê¡ßï¥ßê¡ ßêÿßêìßïòßè¡ßë╡..."
                        value={announcementForm.body}
                        onChange={e => setAnnouncementForm(p => ({ ...p, body: e.target.value }))}
                        style={{ gridColumn: "1/-1", minHeight: 100 }}
                        required
                      />
                      <button className="btn" type="submit" style={{ gridColumn: "1/-1", marginTop: 0 }}>
                        ≡ƒôó ßêêßêüßêëßê¥ ßê░ßê½ßë░ßè₧ßë╜ ßêïßè¡
                      </button>
                    </div>
                  </form>
                </div>
                <div className="card">
                  <h3>ßê¢ßê╡ßë│ßïêßëéßï½ ßï¥ßê¡ßï¥ßê¡ ({(db.announcements || []).length})</h3>
                  {(db.announcements || []).length === 0
                    ? <p style={{ color: "#94a3b8", fontSize: 13 }}>ßê¥ßèòßê¥ ßê¢ßê╡ßë│ßïêßëéßï½ ßèáßêìßë░ßêïßè¿ßê¥ßìó</p>
                    : <div className="msg-list">
                      {(db.announcements || []).map(a => (
                        <div key={a.id} className="msg-bubble admin-bubble">
                          <div className="msg-from" style={{ display: "flex", justifyContent: "space-between" }}>
                            <span>≡ƒôó {a.title} ┬╖ {a.date}</span>
                            <span style={{ color: "#16a34a", fontSize: 11 }}>≡ƒæü {(a.readBy || []).length} ßèáßèÉßëáßëí</span>
                          </div>
                          <p style={{ margin: "6px 0 8px" }}>{a.body}</p>
                          <button className="btn-danger btn-sm" onClick={() => deleteAnnouncement(a.id)}>ßê░ßê¡ßï¥</button>
                        </div>
                      ))}
                    </div>
                  }
                </div>
              </section>
            )
          }

          {/* ===== MESSAGES (chat thread) ===== */}
          {
            section === "Messages" && (
              <section style={{ display: "grid", gridTemplateColumns: "280px 1fr", gap: 16, minHeight: "75vh" }}>
                {/* Left: employee list */}
                <div className="card" style={{ padding: 16, overflowY: "auto" }}>
                  <h3 style={{ margin: "0 0 12px", fontSize: 15 }}>ßê░ßê½ßë░ßè₧ßë╜</h3>
                  <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
                    {(db.employees || []).length === 0
                      ? <p style={{ color: "#94a3b8", fontSize: 13 }}>ßê¥ßèòßê¥ ßê░ßê½ßë░ßè¢ ßï¿ßêêßê¥ßìó</p>
                      : (db.employees || []).map(e => {
                        const unread = (db.messages || []).filter(
                          m => m.from === String(e.id) && m.to === "admin" && !m.readByAdmin
                        ).length;
                        const isActive = msgThreadEmpId === String(e.id);
                        return (
                          <button
                            key={e.id}
                            onClick={() => { setMsgThreadEmpId(String(e.id)); markAdminMsgsRead(); }}
                            style={{
                              textAlign: "left", padding: "10px 12px", borderRadius: 10,
                              border: `1px solid ${isActive ? "#2563eb" : "#e2e8f0"}`,
                              background: isActive ? "#2563eb" : "transparent",
                              color: isActive ? "white" : "inherit",
                              cursor: "pointer", display: "flex", justifyContent: "space-between", alignItems: "center",
                            }}
                          >
                            <div>
                              <div style={{ fontWeight: 600, fontSize: 14 }}>{e.name}</div>
                              <div style={{ fontSize: 11, opacity: 0.75 }}>{e.department}</div>
                            </div>
                            {unread > 0 && <span className="badge">{unread}</span>}
                          </button>
                        );
                      })
                    }
                  </div>

                  {/* Quick send form */}
                  <div style={{ marginTop: 16, borderTop: "1px solid #e2e8f0", paddingTop: 12 }}>
                    <p style={{ fontSize: 11, color: "#94a3b8", margin: "0 0 8px" }}>ßëÇßîÑßë│ ßêïßè¡:</p>
                    <form onSubmit={sendAdminMsg}>
                      <select
                        value={msgForm.toId}
                        onChange={e => setMsgForm(p => ({ ...p, toId: e.target.value }))}
                        style={{ width: "100%", padding: "6px 8px", borderRadius: 6, border: "1px solid #cbd5e1", marginBottom: 6, fontSize: 13 }}
                        required
                      >
                        <option value="">ßê░ßê½ßë░ßè¢ ßê¥ßê¿ßîÑ</option>
                        {(db.employees || []).map(e => <option key={e.id} value={e.id}>{e.name}</option>)}
                      </select>
                      <textarea
                        placeholder="ßêÿßêìßïòßè¡ßë╡..."
                        value={msgForm.body}
                        onChange={e => setMsgForm(p => ({ ...p, body: e.target.value }))}
                        style={{ width: "100%", padding: "6px 8px", borderRadius: 6, border: "1px solid #cbd5e1", minHeight: 60, fontSize: 13, resize: "vertical" }}
                        required
                      />
                      <button className="btn" type="submit" style={{ width: "100%", marginTop: 6 }}>ßêïßè¡ ΓåÆ</button>
                    </form>
                  </div>
                </div>

                {/* Right: chat thread */}
                <div className="card" style={{ display: "flex", flexDirection: "column", padding: 16 }}>
                  {!msgThreadEmpId ? (
                    <div style={{ display: "flex", alignItems: "center", justifyContent: "center", flex: 1, color: "#94a3b8", flexDirection: "column", gap: 8 }}>
                      <span style={{ fontSize: 40 }}>≡ƒÆ¼</span>
                      <span>ßëáßîìßê½ ßëáßè⌐ßêì ßê░ßê½ßë░ßè¢ ßê¥ßê¿ßîÑ ΓÇö ßï¿ßïìßï¡ßï¡ßë▒ ßï¥ßê¡ßï¥ßê¡ ßï¡ßë│ßï½ßêì</span>
                    </div>
                  ) : (() => {
                    const selEmp = (db.employees || []).find(e => String(e.id) === msgThreadEmpId);
                    const thread = [...(db.messages || [])].filter(
                      m => (m.from === msgThreadEmpId && m.to === "admin") ||
                        (m.from === "admin" && m.to === msgThreadEmpId)
                    ).sort((a, b) => a.id - b.id);
                    return (
                      <>
                        <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 12, paddingBottom: 10, borderBottom: "1px solid #e2e8f0" }}>
                          <div>
                            <strong style={{ fontSize: 16 }}>{selEmp?.name}</strong>
                            <span className="dept-badge" style={{ marginLeft: 8 }}>{selEmp?.department}</span>
                          </div>
                        </div>
                        <div style={{ flex: 1, overflowY: "auto", display: "flex", flexDirection: "column", gap: 10, maxHeight: "calc(75vh - 200px)", padding: "4px 0" }}>
                          {thread.length === 0
                            ? <p style={{ color: "#94a3b8", fontSize: 13, textAlign: "center", marginTop: 40 }}>ßê¥ßèòßê¥ ßêÿßêìßïòßè¡ßë╡ ßï¿ßêêßê¥ßìó</p>
                            : thread.map(m => {
                              const isAdmin = m.from === "admin";
                              return (
                                <div key={m.id} style={{ display: "flex", justifyContent: isAdmin ? "flex-end" : "flex-start", alignItems: "flex-start", gap: 4 }}>
                                  <div className={`msg-bubble ${isAdmin ? "admin-bubble" : "emp-bubble"}`} style={{ maxWidth: "65%" }}>
                                    <div className="msg-from">{isAdmin ? "Admin" : selEmp?.name} ┬╖ {m.date}</div>
                                    <p>{m.body}</p>
                                  </div>
                                  <button
                                    onClick={() => deleteMessage(m.id)}
                                    title="ßê░ßê¡ßï¥"
                                    style={{ background: "none", border: "none", cursor: "pointer", color: "#ef4444", fontSize: 14, padding: "4px", opacity: 0.6, flexShrink: 0, marginTop: 4 }}
                                    onMouseEnter={e => e.currentTarget.style.opacity = "1"}
                                    onMouseLeave={e => e.currentTarget.style.opacity = "0.6"}
                                  >≡ƒùæ∩╕Å</button>
                                </div>
                              );
                            })
                          }
                        </div>
                        <form onSubmit={sendThreadReply} style={{ display: "flex", gap: 8, marginTop: 10, borderTop: "1px solid #e2e8f0", paddingTop: 10 }}>
                          <input
                            style={{ flex: 1, padding: "9px 12px", border: "1px solid #cbd5e1", borderRadius: 8, fontSize: 14 }}
                            placeholder="ßêÿßêìßïòßè¡ßë╡ ßï¡ßî╗ßìë..."
                            value={threadReply}
                            onChange={e => setThreadReply(e.target.value)}
                          />
                          <button className="btn" type="submit" style={{ marginTop: 0, padding: "9px 18px" }}>ßêïßè¡</button>
                        </form>
                      </>
                    );
                  })()}
                </div>
              </section>
            )
          }

          {/* ===== RESIGNATIONS ===== */}
          {
            section === "Resignations" && (
              <section>
                <div className="card">
                  <h3>≡ƒô¥ ßê╡ßê½ ßêÿßêìßëÇßëéßï½ ßîÑßï½ßëäßïÄßë╜
                    {pendingResignations > 0 && <span className="badge" style={{ marginLeft: 8 }}>{pendingResignations} Pending</span>}
                  </h3>
                  {(db.resignations || []).length === 0
                    ? <p style={{ color: "#94a3b8" }}>ßê¥ßèòßê¥ ßê╡ßê½ ßêÿßêìßëÇßëéßï½ ßîÑßï½ßëä ßèáßêìßëÇßê¿ßëáßê¥ßìó</p>
                    : (
                      <table className="report-table">
                        <thead>
                          <tr><th>ßê░ßê½ßë░ßè¢</th><th>ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡</th><th>ßê¥ßè¡ßèòßï½ßë╡</th><th>ßï¿ßêÿßî¿ßê¿ßê╗ ßï¿ßê╡ßê½ ßëÇßèò</th><th>ßï¿ßëÇßê¿ßëá ßëÇßèò</th><th>ßêüßèößë│</th><th>ßï╡ßê¡ßîèßë╡</th></tr>
                        </thead>
                        <tbody>
                          {(db.resignations || []).map(r => (
                            <tr key={r.id}>
                              <td style={{ fontWeight: 600 }}>{r.empName}</td>
                              <td><span className="dept-badge">{r.department}</span></td>
                              <td>{r.reason}</td>
                              <td style={{ fontWeight: 700, color: "#ef4444" }}>{r.lastDay}</td>
                              <td>{r.submittedDate}</td>
                              <td>
                                <span className={`status-badge ${r.status === "Acknowledged" ? "approved" : "pending"}`}>
                                  {r.status === "Acknowledged" ? "Γ£à ßë░ßëÇßëáßêê" : "ΓÅ│ Pending"}
                                </span>
                              </td>
                              <td>
                                <div style={{ display: "flex", gap: 4, flexWrap: "wrap" }}>
                                  {r.status === "Pending" && (
                                    <button
                                      className="btn btn-sm"
                                      style={{ marginTop: 0, padding: "5px 12px", fontSize: 12, background: "#16a34a" }}
                                      onClick={() => acknowledgeResignation(r.id)}
                                    >
                                      Γ£à ßë░ßëÇßëáßêê
                                    </button>
                                  )}
                                  <button className="btn-danger btn-sm" onClick={() => deleteResignation(r.id)}>≡ƒùæ∩╕Å ßê░ßê¡ßï¥</button>
                                </div>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    )
                  }
                </div>
              </section>
            )
          }

          {/* ===== REPORTS ΓÇö Income Statement ===== */}
          {
            section === "Reports" && (() => {
              const now = new Date();
              const yr = now.getFullYear(); const mo = now.getMonth();
              const etYear = yr - 7;
              const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

              const monthlyInc = db.incomeEntries.filter(e => { const d = new Date(e.date); return d.getFullYear() === yr && d.getMonth() === mo; });
              const monthlyExp = db.expenseEntries.filter(e => { const d = new Date(e.date); return d.getFullYear() === yr && d.getMonth() === mo; });

              const mData = buildStatementData(monthlyInc, monthlyExp);
              const aData = buildStatementData(db.incomeEntries, db.expenseEntries);

              const fmt = (n) => Number(n).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

              const IncomeStatement = ({ data, periodLabel, isMonthly }) => (
                <div className="income-statement-wrap">
                  {/* org logo if available */}
                  {db.organizationLogo && (
                    <div style={{ textAlign: "center", marginBottom: 10 }}>
                      <img src={db.organizationLogo} alt="logo" style={{ height: 60, objectFit: "contain" }} />
                    </div>
                  )}
                  <div className="is-header">
                    <div className="is-org">[{db.organizationLogoText || db.organizationName}]</div>
                    <div className="is-title">ßï¿ßîêßëóßèô ßïêßî¬ ßêÿßîìßêêßî½ (Income Statement)</div>
                    <div className="is-subtitle">
                      ßêê{etYear} ßèá.ßê¥. ({isMonthly ? `For the Month of ${monthNames[mo]} ${yr}` : `For the Year Ended ${yr}`})
                    </div>
                  </div>

                  <table className="is-table">
                    <thead>
                      <tr>
                        <th style={{ width: "58%" }}>ßï¿ßêéßê│ßëÑ ßêÿßï¡ßëÑ (Account Description)</th>
                        <th style={{ width: "21%", textAlign: "right" }}>ßèÉßîëßê╡ ßï╡ßê¥ßê¡ (ETB)</th>
                        <th style={{ width: "21%", textAlign: "right" }}>ßïïßèô ßï╡ßê¥ßê¡ (ETB)</th>
                      </tr>
                    </thead>
                    <tbody>

                      {/* ΓöÇΓöÇ Revenue ΓöÇΓöÇ */}
                      <tr className="is-row">
                        <td>ßè¿ßê╜ßï½ßî¡ ßïêßï¡ßê¥ ßï¿ßèáßîáßëâßêïßï«ßë╡ ßîêßëó (Revenue)</td>
                        <td></td>
                        <td className="is-amt">{fmt(data.revenue)}</td>
                      </tr>
                      <tr className="is-row">
                        <td>ßêìßëàßèÉßê╡: ßï¿ßê╜ßï½ßî¡ ßïòßëâßïÄßë╜ ßïïßîï (Cost of Goods Sold ΓÇô COGS)</td>
                        <td className="is-amt">{fmt(data.cogs)}</td>
                        <td></td>
                      </tr>
                      <tr className="is-row is-bold is-gross">
                        <td>ßèáßîáßëâßêïßï¡ ßë╡ßê¡ßìì (Gross Profit)</td>
                        <td></td>
                        <td className="is-amt">{fmt(data.grossProfit)}</td>
                      </tr>

                      <tr className="is-spacer"><td colSpan={3}></td></tr>

                      {/* ΓöÇΓöÇ Operating Expenses header ΓöÇΓöÇ */}
                      <tr className="is-section-header">
                        <td colSpan={3}>ßï¿ßêÑßê½ ßê¢ßê╡ßè¼ßîâ ßïêßî¬ßïÄßë╜ (Operating Expenses):</td>
                      </tr>

                      {/* Fixed rows ΓÇö always shown exactly as in the image */}
                      <tr className="is-row is-indent">
                        <td>ßï¿ßê░ßê½ßë░ßè₧ßë╜ ßï░ßê₧ßï¥ (Salaries &amp; Wages)</td>
                        <td className="is-amt">{fmt(data.salaries)}</td>
                        <td></td>
                      </tr>
                      <tr className="is-row is-indent">
                        <td>ßï¿ßëóßê« ßïêßï¡ßê¥ ßï¿ßê▒ßëà ßè¬ßê½ßï¡ (Rent Expense)</td>
                        <td className="is-amt">{fmt(data.rent)}</td>
                        <td></td>
                      </tr>
                      <tr className="is-row is-indent">
                        <td>ßïìßêâßìú ßêÿßëÑßê½ßë╡ßèô ßê╡ßêìßè¡ (Utilities)</td>
                        <td className="is-amt">{fmt(data.utilities)}</td>
                        <td></td>
                      </tr>
                      <tr className="is-row is-indent">
                        <td>ßï¿ßë╡ßê¡ßèòßê╡ßìûßê¡ßë╡ßèô ßêÄßîàßê╡ßë▓ßè¡ßê╡ (Transport)</td>
                        <td className="is-amt">{fmt(data.transport)}</td>
                        <td></td>
                      </tr>
                      <tr className="is-row is-indent">
                        <td>ßêìßï⌐ ßêìßï⌐ ßïêßî¬ßïÄßë╜ (Miscellaneous)</td>
                        <td className="is-amt">{fmt(data.misc)}</td>
                        <td></td>
                      </tr>

                      {/* Dynamic "other" expense categories not in the fixed list */}
                      {data.otherRows.map(({ cat, amt }) => (
                        <tr key={cat} className="is-row is-indent">
                          <td>{cat}</td>
                          <td className="is-amt">{fmt(amt)}</td>
                          <td></td>
                        </tr>
                      ))}

                      {/* Total OpEx */}
                      <tr className="is-row is-bold is-totalopex">
                        <td>ßîáßëàßêïßêï ßï¿ßêÑßê½ ßê¢ßê╡ßè¼ßîâ ßïêßî¬ (Total Operating Expenses)</td>
                        <td></td>
                        <td className="is-amt">{fmt(data.totalOpEx)}</td>
                      </tr>

                      <tr className="is-spacer"><td colSpan={3}></td></tr>

                      {/* ΓöÇΓöÇ Bottom lines ΓöÇΓöÇ */}
                      <tr className="is-row is-bold">
                        <td>ßï¿ßë░ßîúßê½ ßï¿ßèòßîìßï╡ ßë╡ßê¡ßìì (Net Operating Income)</td>
                        <td></td>
                        <td className="is-amt" style={{ color: data.netOperatingIncome >= 0 ? "#16a34a" : "#ef4444" }}>
                          {fmt(data.netOperatingIncome)}
                        </td>
                      </tr>
                      <tr className="is-row">
                        <td>ßêìßëàßèÉßê╡: ßï¿ßîêßëó ßîìßëÑßê¡ / ßë│ßè¡ßê╡ (Income Tax Expense ΓÇö 30%)</td>
                        <td></td>
                        <td className="is-amt">{fmt(data.tax)}</td>
                      </tr>
                      <tr className="is-row is-netprofit">
                        <td>ßï¿ßïôßêÿßë▒ ßï¿ßë░ßîúßê½ ßë╡ßê¡ßìì (Net Profit for the Year)</td>
                        <td></td>
                        <td className="is-amt">{fmt(data.netProfit)}</td>
                      </tr>

                    </tbody>
                  </table>

                  <button
                    className="btn"
                    style={{ marginTop: 18 }}
                    onClick={() => exportIncomeStatement(periodLabel, data)}
                  >
                    ≡ƒôÑ Export to Excel
                  </button>
                </div>
              );

              return (
                <section>
                  <div className="report-tabs" style={{ display: "flex", gap: 10, marginBottom: 22 }}>
                    {[
                      ["monthly", `≡ƒôà ßïêßê¡ßêâßïè ßê¬ßìûßê¡ßë╡ ΓÇö ${monthNames[mo]} ${yr}`],
                      ["annual", `≡ƒôè ßèáßêÿßë│ßïè ßê¬ßìûßê¡ßë╡ ΓÇö ${yr}`],
                    ].map(([k, l]) => (
                      <button key={k} className={`hrm-tab ${reportTab === k ? "active" : ""}`} onClick={() => setReportTab(k)}>{l}</button>
                    ))}
                  </div>
                  {reportTab === "monthly" && <IncomeStatement data={mData} periodLabel={`${monthNames[mo]}_${yr}`} isMonthly={true} />}
                  {reportTab === "annual" && <IncomeStatement data={aData} periodLabel={`Annual_${yr}`} isMonthly={false} />}
                </section>
              );
            })()
          }

          {/* ===== BALANCE SHEET ΓÇö ßï¿ßêâßëÑßë╡ßèô ßèÑßï│ ßê¥ßï¥ßîêßëú ===== */}
          {section === "Balance Sheet" && (() => {
            const bs = db.balanceSheet || DEFAULT.balanceSheet;
            const n = (v) => Number(v) || 0;
            const fmt = (v) => Number(v).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            // Computed totals
            const totalCurrentAssets = n(bs.cashAndBank) + n(bs.accountsReceivable) + n(bs.inventory);
            const totalNonCurrentAssets = n(bs.equipmentAndVehicles) - n(bs.accumulatedDepreciation);
            const totalAssets = totalCurrentAssets + totalNonCurrentAssets;
            const totalCurrentLiab = n(bs.accountsPayable) + n(bs.taxPayable);

            // Pull net profit from income statement
            const aData = buildStatementData(db.incomeEntries, db.expenseEntries);
            const netProfit = aData.netProfit;

            const totalEquity = n(bs.capital) + n(bs.retainedEarnings) + netProfit;
            const totalLiabEquity = totalCurrentLiab + totalEquity;

            const etYear = new Date().getFullYear() - 7;

            const Field = ({ label, fkey, wide }) => (
              <div className={`bs-field${wide ? " bs-field-wide" : ""}`}>
                <label className="bs-field-label">{label}</label>
                <input
                  type="number"
                  className="bs-field-input"
                  placeholder="0.00"
                  value={bsForm[fkey] ?? ""}
                  onChange={e => setBsForm(p => ({ ...p, [fkey]: e.target.value }))}
                />
              </div>
            );

            return (
              <section>
                {/* ΓöÇΓöÇ FORM (edit mode) ΓöÇΓöÇ */}
                {bsEditing ? (
                  <div className="bs-form-card">
                    <div className="bs-form-header">
                      <h2 style={{ margin: 0 }}>≡ƒôï Balance Sheet ßê¥ßï¥ßîêßëú</h2>
                      <div style={{ display: "flex", gap: 10 }}>
                        <button className="btn" style={{ marginTop: 0 }} onClick={saveBalanceSheet}>≡ƒÆ╛ ßèáßê╡ßëÇßê¥ßîÑ</button>
                        <button className="secondary-btn" style={{ marginTop: 0 }} onClick={() => setBsEditing(false)}>Γ£ò ßê░ßê¡ßï¥</button>
                      </div>
                    </div>

                    <div style={{ marginBottom: 18 }}>
                      <label className="bs-field-label">≡ƒôà ßï¿ßê¬ßìûßê¡ßë▒ ßëÇßèò (As of Date)</label>
                      <input type="date" className="bs-field-input" style={{ maxWidth: 220 }}
                        value={bsForm.asOfDate} onChange={e => setBsForm(p => ({ ...p, asOfDate: e.target.value }))} />
                    </div>

                    <div className="bs-form-grid">
                      {/* LEFT ΓÇö Assets */}
                      <div>
                        <div className="bs-section-title">ßêâßëÑßë╡ (Assets)</div>

                        <div className="bs-sub-title">ßï¿ßèáßêüßèæ ßîèßï£ ßêâßëÑßë╡ (Current Assets)</div>
                        <Field label="ßîÑßê¼ ßèôßèòßï½ ßïêßï¡ßê¥ ßêâ/ßîèßï£ ßîêßèòßïÿßëÑ ΓÇö Cash & Bank" fkey="cashAndBank" />
                        <Field label="ßï½ßêìßëÇßìêßêë ßï░ßê¿ßê░ßè¥ ßïòßï│ ΓÇö Accounts Receivable" fkey="accountsReceivable" />
                        <Field label="ßï¿ßïòßëâ ßè¡ßê¥ßë╜ßë╡ ΓÇö Inventory" fkey="inventory" />

                        <div className="bs-sub-title" style={{ marginTop: 18 }}>ßëïßêÜ ßîèßï£ ßêâßëÑßë╡ (Non-Current Assets)</div>
                        <Field label="ßêÿßê│ßê¬ßï½ßèô ßë░ßê╕ßè¿ßê¡ßè½ßê¬ ΓÇö Equipment & Vehicles" fkey="equipmentAndVehicles" />
                        <Field label="ßêìßëÇßê░: ßï¿ßë░ßîáßê½ßëÇßêÿ ßèÑßê¡ßîàßèô ΓÇö Accumulated Depreciation" fkey="accumulatedDepreciation" />
                      </div>

                      {/* RIGHT ΓÇö Liabilities & Equity */}
                      <div>
                        <div className="bs-section-title">ßïòßï│ßèô ßè½ßìÆßë│ßêì (Liabilities &amp; Equity)</div>

                        <div className="bs-sub-title">ßï¿ßèáßêüßèæ ßîèßï£ ßïòßï│ (Current Liabilities)</div>
                        <Field label="ßêîßêÄßë╗ßë╕ßê₧ßë╜ ßï½ßêìßëÇßìêßêëßë╡ ΓÇö Accounts Payable" fkey="accountsPayable" />
                        <Field label="ßï½ßêìßëÇßìêßêë ßîìßëÑßê¡/ßë│ßè¡ßê╡ ΓÇö Tax Payable" fkey="taxPayable" />

                        <div className="bs-sub-title" style={{ marginTop: 18 }}>ßï¿ßëúßêêßëñßë▒ ßè½ßìÆßë│ßêì (Owner's Equity)</div>
                        <Field label="ßï¿ßêÿßîÇßêÿßê¬ßï½ ßêÖßêë ßè½ßìÆßë│ßêì ΓÇö Capital" fkey="capital" />
                        <Field label="ßï¿ßë░ßîáßê½ßëÇßêÖ ßë╡ßê¡ßìì ΓÇö Retained Earnings" fkey="retainedEarnings" />
                        <div className="bs-auto-row">
                          <span>ßï¿ßïôßêÿßë▒ ßï¿ßë░ßîúßê½ ßë╡ßê¡ßìì ΓÇö Net Profit (auto)</span>
                          <strong style={{ color: netProfit >= 0 ? "#16a34a" : "#ef4444" }}>{fmt(netProfit)} ETB</strong>
                        </div>
                      </div>
                    </div>
                  </div>
                ) : (
                  /* ΓöÇΓöÇ DISPLAY MODE ΓÇö Balance Sheet table matching the image ΓöÇΓöÇ */
                  <div>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
                      <div>
                        <button className="btn" style={{ marginTop: 0 }} onClick={startEditBs}>Γ£Å∩╕Å ßï¥ßê¡ßï¥ßê¡ ßê¥ßï¥ßîìßëÑ / ßèáßê¡ßë╡ßïò</button>
                        <button className="secondary-btn" style={{ marginTop: 0, marginLeft: 10 }} onClick={exportBalanceSheet}>≡ƒôÑ Export Excel</button>
                      </div>
                    </div>

                    <div className="bs-display-wrap">
                      {/* ΓöÇΓöÇ Header ΓöÇΓöÇ */}
                      <div className="bs-display-header">
                        {db.organizationLogo && <img src={db.organizationLogo} alt="logo" style={{ height: 52, objectFit: "contain", marginBottom: 6 }} />}
                        <div className="bs-display-org">[{db.organizationLogoText || db.organizationName}]</div>
                        <div className="bs-display-title">ßï¿ßêâßëÑßë╡ßèô ßèÑßï│ ßêÿßîìßêêßî½ (Balance Sheet)</div>
                        <div className="bs-display-subtitle">
                          ßèá.ßèá. ßêÉßê¥ßêî 30/{etYear} ßëÇßèò ßèáßèòßìâßê¡ ({bs.asOfDate ? `As of ${bs.asOfDate}` : "As of ΓÇö"})
                        </div>
                      </div>

                      {/* ΓöÇΓöÇ Two-column table ΓöÇΓöÇ */}
                      <div className="bs-cols">

                        {/* LEFT ΓÇö Assets */}
                        <table className="bs-table">
                          <thead>
                            <tr>
                              <th>ßêâßëÑßë╡ (Assets)</th>
                              <th>ßëÑßê¡ (ETB)</th>
                            </tr>
                          </thead>
                          <tbody>
                            {/* Current Assets */}
                            <tr className="bs-section-row"><td colSpan={2}>ßï¿ßèáßêüßèæ ßîèßï£ ßêâßëÑßë╡ (Current Assets)</td></tr>
                            <tr className="bs-data-row">
                              <td>ßîÑßê¼ ßèôßèòßï½ ßïêßï¡ßê¥ ßêâ/ßîèßï£ ßîêßèòßïÿßëÑ (Cash &amp; Bank)</td>
                              <td className="bs-amt">{fmt(bs.cashAndBank || 0)}</td>
                            </tr>
                            <tr className="bs-data-row">
                              <td>ßï½ßêìßëÇßìêßêë ßï░ßê¿ßê░ßè¥ ßïòßï│ (Accounts Receivable)</td>
                              <td className="bs-amt">{fmt(bs.accountsReceivable || 0)}</td>
                            </tr>
                            <tr className="bs-data-row">
                              <td>ßï¿ßïòßëâ ßè¡ßê¥ßë╜ßë╡ (Inventory)</td>
                              <td className="bs-amt">{fmt(bs.inventory || 0)}</td>
                            </tr>
                            <tr className="bs-total-row">
                              <td>ßîáßëàßêïßêï ßï¿ßèáßêüßèæ ßîèßï£ ßêâßëÑßë╡</td>
                              <td className="bs-amt">{fmt(totalCurrentAssets)}</td>
                            </tr>

                            <tr className="bs-spacer"><td colSpan={2}></td></tr>

                            {/* Non-Current Assets */}
                            <tr className="bs-section-row"><td colSpan={2}>ßëïßêÜ ßîèßï£ ßêâßëÑßë╡ (Non-Current Assets)</td></tr>
                            <tr className="bs-data-row">
                              <td>ßêÿßê│ßê¬ßï½ßèô ßë░ßê╕ßè¿ßê¡ßè½ßê¬ (Equipment &amp; Vehicles)</td>
                              <td className="bs-amt">{fmt(bs.equipmentAndVehicles || 0)}</td>
                            </tr>
                            <tr className="bs-data-row">
                              <td>ßêìßëÇßê░: ßï¿ßë░ßîáßê½ßëÇßêÿ ßèÑßê¡ßîàßèô (Acc. Depreciation)</td>
                              <td className="bs-amt" style={{ color: "#ef4444" }}>({fmt(bs.accumulatedDepreciation || 0)})</td>
                            </tr>
                            <tr className="bs-total-row">
                              <td>ßîáßëàßêïßêï ßëïßêÜ ßîèßï£ ßêâßëÑßë╡</td>
                              <td className="bs-amt">{fmt(totalNonCurrentAssets)}</td>
                            </tr>

                            <tr className="bs-spacer"><td colSpan={2}></td></tr>
                            <tr className="bs-grand-total-row">
                              <td>ßîáßëàßêïßêï ßêâßëÑßë╡ (Total Assets)</td>
                              <td className="bs-amt">{fmt(totalAssets)}</td>
                            </tr>
                          </tbody>
                        </table>

                        {/* RIGHT ΓÇö Liabilities & Equity */}
                        <table className="bs-table">
                          <thead>
                            <tr>
                              <th>ßïòßï│ ßè½ßìÆßë│ßêì (Liabilities &amp; Equity)</th>
                              <th>ßëÑßê¡ (ETB)</th>
                            </tr>
                          </thead>
                          <tbody>
                            {/* Current Liabilities */}
                            <tr className="bs-section-row"><td colSpan={2}>ßï¿ßèáßêüßèæ ßîèßï£ ßïòßï│ (Current Liabilities)</td></tr>
                            <tr className="bs-data-row">
                              <td>ßêîßêÄßë╗ßë╕ßê₧ßë╜ ßï½ßêìßëÇßìêßêëßë╡ (Accounts Payable)</td>
                              <td className="bs-amt">{fmt(bs.accountsPayable || 0)}</td>
                            </tr>
                            <tr className="bs-data-row">
                              <td>ßï½ßêìßëÇßìêßêë ßîìßëÑßê¡/ßë│ßè¡ßê╡ (Tax Payable)</td>
                              <td className="bs-amt">{fmt(bs.taxPayable || 0)}</td>
                            </tr>
                            <tr className="bs-total-row">
                              <td>ßîáßëàßêïßêï ßï¿ßèáßêüßèæ ßîèßï£ ßïòßï│</td>
                              <td className="bs-amt">{fmt(totalCurrentLiab)}</td>
                            </tr>

                            <tr className="bs-spacer"><td colSpan={2}></td></tr>

                            {/* Owner's Equity */}
                            <tr className="bs-section-row"><td colSpan={2}>ßï¿ßëúßêêßëñßë▒ ßè½ßìÆßë│ßêì (Owner's Equity)</td></tr>
                            <tr className="bs-data-row">
                              <td>ßï¿ßêÿßîÇßêÿßê¬ßï½ ßêÖßêë ßè½ßìÆßë│ßêì (Capital)</td>
                              <td className="bs-amt">{fmt(bs.capital || 0)}</td>
                            </tr>
                            <tr className="bs-data-row">
                              <td>ßï¿ßë░ßîáßê½ßëÇßêÖ ßë╡ßê¡ßìì (Retained Earnings)</td>
                              <td className="bs-amt">{fmt(bs.retainedEarnings || 0)}</td>
                            </tr>
                            <tr className="bs-data-row">
                              <td>ßï¿ßïôßêÿßë▒ ßï¿ßë░ßîúßê½ ßë╡ßê¡ßìì (Net Profit)</td>
                              <td className="bs-amt" style={{ color: netProfit >= 0 ? "#16a34a" : "#ef4444", fontWeight: 700 }}>{fmt(netProfit)}</td>
                            </tr>
                            <tr className="bs-total-row">
                              <td>ßîáßëàßêïßêï ßï¿ßëúßêêßëñßë▒ ßè½ßìÆßë│ßêì</td>
                              <td className="bs-amt">{fmt(totalEquity)}</td>
                            </tr>

                            <tr className="bs-spacer"><td colSpan={2}></td></tr>
                            <tr className="bs-grand-total-row">
                              <td>ßîáßëàßêïßêï ßïòßï│ßèô ßè½ßìÆßë│ßêì (Total Liabilities &amp; Equity)</td>
                              <td className="bs-amt">{fmt(totalLiabEquity)}</td>
                            </tr>

                            <tr className="bs-spacer"><td colSpan={2}></td></tr>

                            {/* Balance check */}
                            <tr style={{ background: Math.abs(totalAssets - totalLiabEquity) < 1 ? "#dcfce7" : "#fee2e2" }}>
                              <td colSpan={2} style={{ textAlign: "center", fontWeight: 700, fontSize: 13, padding: "8px 14px" }}>
                                {Math.abs(totalAssets - totalLiabEquity) < 1
                                  ? "Γ£à Balance Sheet ßë░ßêƒßêƒßë╖ßêì ΓÇö Assets = Liabilities + Equity"
                                  : `ΓÜá∩╕Å ßêìßï⌐ßèÉßë╡: ${fmt(Math.abs(totalAssets - totalLiabEquity))} ETB ΓÇö ßï¥ßê¡ßï¥ßê«ßë╣ßèò ßï½ßê¿ßîïßîìßîí`
                                }
                              </td>
                            </tr>
                          </tbody>
                        </table>

                      </div>{/* /bs-cols */}
                    </div>{/* /bs-display-wrap */}
                  </div>
                )}
              </section>
            );
          })()}

          {/* ===== DEBT REGISTRATION (Finance) ===== */}
          {
            section === "Debt Registration" && (
              <section className="panel-grid">
                <div className="card">
                  <h3>ßèáßï▓ßê╡ ßèÑßï│ ßê¥ßï¥ßîêßëú</h3>
                  <div className="form-grid" style={{ marginBottom: 12 }}>
                    <input placeholder="Organization" value={debtForm.organization} onChange={e => setDebtForm(p => ({ ...p, organization: e.target.value }))} />
                    <input type="number" placeholder="Total Debt" value={debtForm.total} onChange={e => setDebtForm(p => ({ ...p, total: e.target.value }))} />
                    <input type="number" placeholder="Paid Amount" value={debtForm.paid} onChange={e => setDebtForm(p => ({ ...p, paid: e.target.value }))} />
                    <select value={debtForm.status} onChange={e => setDebtForm(p => ({ ...p, status: e.target.value }))}>
                      {["Pending", "Partial", "Paid"].map(s => <option key={s}>{s}</option>)}
                    </select>
                    <input type="date" value={debtForm.date} onChange={e => setDebtForm(p => ({ ...p, date: e.target.value }))} />
                  </div>
                  <button className="btn" onClick={addDebt}>Save Debt</button>
                </div>
                <div className="card">
                  <h3>ßï¿ßèÑßï│ ßï¥ßê¡ßï¥ßê¡</h3>
                  <table className="report-table">
                    <thead><tr><th>Organization</th><th>Total</th><th>Paid</th><th>Remaining</th><th>Status</th><th>Date</th><th>{t.actions}</th></tr></thead>
                    <tbody>
                      {db.debts.length === 0
                        ? <tr><td colSpan={7} style={{ textAlign: "center", color: "#94a3b8" }}>ßê¥ßèòßê¥ ßèÑßï│ ßï¿ßêêßê¥ßìó</td></tr>
                        : db.debts.map(d => {
                          const isEditing = editDebtId === d.id;
                          return isEditing ? (
                            <tr key={d.id} style={{ background: "#fef3c7" }}>
                              <td><input className="leave-input" value={editDebtForm.organization} onChange={ev => setEditDebtForm(p => ({ ...p, organization: ev.target.value }))} style={{ width: 120 }} /></td>
                              <td><input className="leave-input" type="number" value={editDebtForm.total} onChange={ev => setEditDebtForm(p => ({ ...p, total: ev.target.value }))} style={{ width: 80 }} /></td>
                              <td><input className="leave-input" type="number" value={editDebtForm.paid} onChange={ev => setEditDebtForm(p => ({ ...p, paid: ev.target.value }))} style={{ width: 80 }} /></td>
                              <td style={{ color: "#ef4444", fontWeight: 700 }}>{(Number(editDebtForm.total || 0) - Number(editDebtForm.paid || 0)).toLocaleString()}</td>
                              <td>
                                <select className="leave-input" value={editDebtForm.status} onChange={ev => setEditDebtForm(p => ({ ...p, status: ev.target.value }))} style={{ width: 90 }}>
                                  {["Pending", "Partial", "Paid"].map(s => <option key={s}>{s}</option>)}
                                </select>
                              </td>
                              <td><input className="leave-input" type="date" value={editDebtForm.date} onChange={ev => setEditDebtForm(p => ({ ...p, date: ev.target.value }))} style={{ width: 120 }} /></td>
                              <td>
                                <div style={{ display: "flex", gap: 4 }}>
                                  <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 8px", fontSize: 12, background: "#16a34a" }} onClick={() => saveEditDebt(d.id)}>≡ƒÆ╛</button>
                                  <button className="btn-danger btn-sm" onClick={() => setEditDebtId(null)}>Γ£ò</button>
                                </div>
                              </td>
                            </tr>
                          ) : (
                            <tr key={d.id}>
                              <td>{d.organization}</td>
                              <td>{d.total.toLocaleString()}</td>
                              <td style={{ color: "#16a34a" }}>{d.paid.toLocaleString()}</td>
                              <td style={{ color: "#ef4444", fontWeight: 700 }}>{(d.total - d.paid).toLocaleString()}</td>
                              <td><span className={`status-badge ${d.status === "Paid" ? "approved" : d.status === "Partial" ? "pending" : "rejected"}`}>{d.status}</span></td>
                              <td>{d.date}</td>
                              <td>
                                <div style={{ display: "flex", gap: 4 }}>
                                  <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 8px", fontSize: 12, background: "#2563eb" }} onClick={() => startEditDebt(d)}>Γ£Å∩╕Å</button>
                                  <button className="btn-danger btn-sm" onClick={() => deleteDebt(d.id)}>≡ƒùæ∩╕Å</button>
                                </div>
                              </td>
                            </tr>
                          );
                        })
                      }
                    </tbody>
                  </table>
                </div>
              </section>
            )
          }

          {/* ===== PAYROLL (Finance) ===== */}
          {
            section === "Payroll" && (
              <section>
                <div className="panel-grid" style={{ marginBottom: 18 }}>
                  <div className="card">
                    <h3>ßï░ßê₧ßï¥ ßè¿ßììßï½ (Payroll)</h3>
                    <p style={{ color: "#64748b", fontSize: 13, margin: "0 0 12px" }}>ßêüßêëßê¥ ßê░ßê½ßë░ßè₧ßë╜ ßï░ßê₧ßï¥ ßê▓ßï░ßèò ßè¿ßïÜßêà ßëúßèòßè¡ ßïêßî¬ ßï¡ßï░ßê¿ßîïßêìßìó</p>
                    <div className="form-grid" style={{ marginBottom: 12 }}>
                      <select value={payrollBankId} onChange={e => setPayrollBankId(e.target.value)}>
                        <option value="">ßëúßèòßè¡ ßê¥ßê¿ßîÑ</option>
                        {(db.bankAccounts || []).map(b => <option key={b.id} value={b.id}>{b.name} ({b.accountNumber})</option>)}
                      </select>
                      <input type="date" value={payrollDate} onChange={e => setPayrollDate(e.target.value)} />
                    </div>
                    {(db.employees || []).length > 0 && (
                      <div className="payroll-totals">
                        <div className="payroll-total-row"><span>ßê░ßê½ßë░ßè₧ßë╜</span><strong>{(db.employees || []).length}</strong></div>
                        <div className="payroll-total-row"><span>ßîáßëàßêïßêï ßï░ßê₧ßï¥</span><strong>{(db.employees || []).reduce((s, e) => s + e.basicSalary, 0).toLocaleString()} Birr</strong></div>
                        <div className="payroll-total-row pension-row"><span>ßîíßê¿ßë│</span><strong>-{(db.employees || []).reduce((s, e) => s + (e.pension || 0), 0).toFixed(0)} Birr</strong></div>
                        <div className="payroll-total-row net-row"><span>ßîáßëàßêïßêï ßï¿ßêÜßè¿ßìêßêì</span><strong>{(db.employees || []).reduce((s, e) => s + e.netPay, 0).toFixed(0)} Birr</strong></div>
                      </div>
                    )}
                    <div style={{ display: "flex", gap: 10, marginTop: 14 }}>
                      <button className="btn" style={{ flex: 1 }} onClick={payAllSalaries}>Γ£à ßï░ßèò ΓÇö ßïêßî¬ ßê¥ßï¥ßîìßëÑ</button>
                      <button className="secondary-btn" style={{ flex: 1 }} onClick={exportPayroll}>≡ƒôÑ Excel Export</button>
                    </div>
                  </div>
                  <div className="card">
                    <h3>Payroll Preview</h3>
                    <table className="report-table">
                      <thead><tr><th>ßë░.ßëü</th><th>ßê╡ßê¥</th><th>ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡</th><th>ßê╡ßêìßè¡</th><th>ßèáßè½ßïìßèòßë╡</th><th>ßï░ßê₧ßï¥</th></tr></thead>
                      <tbody>{(db.employees || []).map((e, i) => (
                        <tr key={e.id}>
                          <td>{i + 1}</td><td>{e.name}</td><td><span className="dept-badge">{e.department}</span></td>
                          <td>{e.phone || "ΓÇö"}</td><td>{e.bankAccount || "ΓÇö"}</td>
                          <td style={{ color: "#16a34a", fontWeight: 700 }}>{e.netPay.toFixed(0)} Birr</td>
                        </tr>
                      ))}</tbody>
                    </table>
                  </div>
                </div>

                {/* Per-employee payroll edit */}
                <div className="card">
                  <h3>≡ƒÆ╝ ßìößê«ßêì ßê¢ßê╡ßë░ßè½ßè¿ßï½ ΓÇö ßï▓ßïìßë▓ßìú ßîíßê¿ßë│ßìú ßï░ßê₧ßï¥</h3>
                  <p style={{ color: "#64748b", fontSize: 13, margin: "0 0 12px" }}>ßêêßèÑßï½ßèòßï│ßï▒ ßê░ßê½ßë░ßè¢ ßï▓ßïìßë▓ ßê¢ßè¿ßêìßìú ßîíßê¿ßë│ opt-in/outßìú ßïêßï¡ßê¥ ßï░ßê₧ßï¥ ßê¢ßê╡ßë░ßè½ßè¿ßêìßìó</p>
                  <table className="report-table">
                    <thead>
                      <tr>
                        <th>ßê╡ßê¥</th><th>ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡</th>
                        <th>ßï░ßê₧ßï¥</th><th>ßï▓ßïìßë▓</th>
                        <th>7% ßîíßê¿ßë│</th><th>ßï¿ßêÜßè¿ßìêßêì</th><th>ßèáßê¡ßë╡ßïò</th>
                      </tr>
                    </thead>
                    <tbody>
                      {(db.employees || []).map(e => {
                        const ed = payrollEdit[e.id] || {};
                        const editing = e.id in payrollEdit;
                        const curSal = editing ? (ed.basicSalary ?? e.basicSalary) : e.basicSalary;
                        const curDuty = editing ? (ed.duty ?? (e.duty || 0)) : (e.duty || 0);
                        const curPen = editing ? (ed.pensionOpt ?? e.pensionOpt) : e.pensionOpt;
                        const previewPen = curPen ? (Number(curSal) * 0.07).toFixed(0) : 0;
                        const previewNet = (Number(curSal) * (curPen ? 0.93 : 1) + Number(curDuty)).toFixed(0);
                        return (
                          <tr key={e.id}>
                            <td>{e.name}</td>
                            <td><span className="dept-badge">{e.department}</span></td>
                            <td>
                              {editing
                                ? <input type="number" className="leave-input" style={{ width: 80 }} value={ed.basicSalary ?? e.basicSalary} onChange={ev => setPayrollEdit(p => ({ ...p, [e.id]: { ...p[e.id], basicSalary: ev.target.value } }))} />
                                : `${e.basicSalary.toLocaleString()}`
                              }
                            </td>
                            <td>
                              {editing
                                ? <input type="number" className="leave-input" style={{ width: 70 }} value={ed.duty ?? (e.duty || 0)} onChange={ev => setPayrollEdit(p => ({ ...p, [e.id]: { ...p[e.id], duty: ev.target.value } }))} />
                                : `${(e.duty || 0).toLocaleString()}`
                              }
                            </td>
                            <td>
                              {editing
                                ? <label style={{ display: "flex", alignItems: "center", gap: 4 }}>
                                  <input type="checkbox" checked={ed.pensionOpt ?? e.pensionOpt} onChange={ev => setPayrollEdit(p => ({ ...p, [e.id]: { ...p[e.id], pensionOpt: ev.target.checked } }))} />
                                  {curPen ? <span style={{ color: "#ef4444" }}>-{previewPen}</span> : "ΓÇö"}
                                </label>
                                : (e.pension > 0 ? <span style={{ color: "#ef4444" }}>-{e.pension.toFixed(0)}</span> : "ΓÇö")
                              }
                            </td>
                            <td style={{ color: "#16a34a", fontWeight: 700 }}>
                              {editing ? `${previewNet} Birr` : `${e.netPay.toFixed(0)} Birr`}
                            </td>
                            <td>
                              {!editing
                                ? <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 10px", fontSize: 12 }} onClick={() => setPayrollEdit(p => ({ ...p, [e.id]: {} }))}>Γ£Å∩╕Å</button>
                                : <div style={{ display: "flex", gap: 4 }}>
                                  <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 8px", fontSize: 12, background: "#16a34a" }} onClick={() => savePayrollEdit(e.id)}>≡ƒÆ╛</button>
                                  <button className="btn-danger btn-sm" onClick={() => setPayrollEdit(p => { const n = { ...p }; delete n[e.id]; return n; })}>Γ£ò</button>
                                </div>
                              }
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </section>
            )
          }

          {/* ===== SETTINGS ===== */}
          {
            section === "Settings" && (
              <section className="settings-section">
                <div className="card">
                  <h3>≡ƒÅª Bank Accounts</h3>
                  <form className="form-grid" style={{ marginBottom: 20 }} onSubmit={addBank}>
                    <input placeholder="Bank Name" value={bankForm.name} onChange={e => setBankForm(p => ({ ...p, name: e.target.value }))} required />
                    <input placeholder="Account Number" value={bankForm.accountNumber} onChange={e => setBankForm(p => ({ ...p, accountNumber: e.target.value }))} required />
                    <input type="number" placeholder="Initial Balance" value={bankForm.initialBalance} onChange={e => setBankForm(p => ({ ...p, initialBalance: e.target.value }))} />
                    <button className="btn" type="submit" style={{ marginTop: 0 }}>+ Open Bank</button>
                  </form>
                  <table><thead><tr><th>Bank Name</th><th>Account #</th><th>Current Balance</th><th>Action</th></tr></thead><tbody>
                    {bankSummaries.map(b => (
                      <tr key={b.id}>
                        <td>{b.name}</td><td>{b.accountNumber}</td><td>{b.balance.toLocaleString()} Birr</td>
                        <td><button className="btn-danger btn-sm" onClick={() => deleteBank(b.id)}>Delete</button></td>
                      </tr>
                    ))}
                    {bankSummaries.length === 0 && <tr><td colSpan={4} style={{ color: "#94a3b8", textAlign: "center" }}>No banks yet.</td></tr>}
                  </tbody></table>
                </div>
                <div className="card">
                  <h3>General Settings</h3>
                  <p style={{ margin: "0 0 12px", color: "#64748b" }}>Organization: {db.organizationName}</p>
                  <div className="logo-upload-wrap">
                    <label className="upload-label" htmlFor="otxt">Logo Text</label>
                    <input id="otxt" value={db.organizationLogoText || ""} onChange={e => setDb(p => ({ ...p, organizationLogoText: e.target.value }))} placeholder="Enter logo text" />
                    <label className="upload-label" htmlFor="oupload">Upload Logo</label>
                    <input id="oupload" type="file" accept="image/*" onChange={handleLogoUpload} />
                    {db.organizationLogo && (
                      <div className="logo-preview-box">
                        <img className="logo-preview" src={db.organizationLogo} alt="logo" />
                        <button className="btn" onClick={() => { localStorage.removeItem(LOGO_KEY); setDb(p => ({ ...p, organizationLogo: "" })); showToast("success", "Logo removed."); }}>Remove Logo</button>
                      </div>
                    )}
                    {!db.organizationLogo && <p className="muted-text">No logo uploaded.</p>}
                  </div>
                  <div className="settings-login-card">
                    <h3>Login Account</h3>
                    <div className="form-grid">
                      <input placeholder="Full Name" value={db.loginAccount?.fullName || ""} onChange={e => setDb(p => ({ ...p, loginAccount: { ...p.loginAccount, fullName: e.target.value } }))} />
                      <input placeholder="Phone" value={db.loginAccount?.phoneNumber || ""} onChange={e => setDb(p => ({ ...p, loginAccount: { ...p.loginAccount, phoneNumber: e.target.value } }))} />
                      <input type="password" placeholder="Password (4 digits)" maxLength={4} value={db.loginAccount?.password || ""} onChange={e => setDb(p => ({ ...p, loginAccount: { ...p.loginAccount, password: e.target.value } }))} />
                      <input placeholder="Credit Account" value={db.loginAccount?.creditAccount || ""} onChange={e => setDb(p => ({ ...p, loginAccount: { ...p.loginAccount, creditAccount: e.target.value } }))} />
                      <input placeholder="Email" value={db.loginAccount?.email || ""} onChange={e => setDb(p => ({ ...p, loginAccount: { ...p.loginAccount, email: e.target.value } }))} />
                    </div>
                    <button className="btn" onClick={() => showToast("success", "Login account updated.")}>Save Login Account</button>
                  </div>

                  {/* ΓöÇΓöÇ Danger Zone ΓöÇΓöÇ */}
                  <div style={{ marginTop: 28, padding: "18px 20px", border: "2px solid #fca5a5", borderRadius: 12, background: "#fff1f2" }}>
                    <h3 style={{ margin: "0 0 8px", color: "#dc2626", fontSize: 15 }}>ΓÜá∩╕Å Danger Zone ΓÇö ßêüßêëßèòßê¥ ßï│ßë│ ßèáßîÑßìï</h3>
                    <p style={{ margin: "0 0 14px", color: "#64748b", fontSize: 13 }}>
                      ßêüßêëßèòßê¥ ßîêßëóßìú ßïêßî¬ßìú ßèÑßï│ßìú ßê░ßê½ßë░ßè₧ßë╜ßìú ßëúßèòßè«ßë╜ßèô ßêîßêÄßë╜ ßï¥ßê¡ßï¥ßê«ßë╜ ßï¡ßîáßìïßêëßìó Login account ßëÑßë╗ ßï¡ßëÇßê½ßêìßìó
                    </p>
                    <button
                      onClick={resetAllData}
                      style={{ background: "#dc2626", color: "white", border: "none", padding: "10px 20px", borderRadius: 8, fontWeight: 700, cursor: "pointer", fontSize: 14 }}
                    >
                      ≡ƒùæ∩╕Å ßêüßêëßèòßê¥ ßï│ßë│ ßèáßîÑßìï (Reset All Data)
                    </button>
                  </div>
                </div>
              </section>
            )
          }
        </main >
      </div >
    </div >
  );
}
