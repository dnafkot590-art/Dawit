  const payAllSalaries = () => {
    const emps = db.employees || [];
    if (!emps.length) { showToast("error", "ßê¥ßèòßê¥ ßê░ßê½ßë░ßè¢ ßï¿ßêêßê¥ßìó"); return; }
    if (!payrollBankId) { showToast("error", "ßëúßèòßè¡ ßê¥ßê¿ßîÑßìó"); return; }
    const expenses = emps.map(emp => ({
      id: Date.now() + emp.id, category: "Salary", bankId: Number(payrollBankId),
      amount: emp.netPay, company: emp.name, date: payrollDate,
      note: `ßï░ßê₧ßï¥:${emp.basicSalary} ßï▓ßïìßë▓:${emp.duty} ßîíßê¿ßë│:-${emp.pension}`,
