                        <option value="emergency">≡ƒÜ¿ ßï╡ßèòßîêßë░ßè¢ ßììßëâßï╡ (Emergency)</option>
                      </select>
                      <input type="number" placeholder="ßëÇßèôßë╡" value={leaveForm.days} onChange={e => setLeaveForm(p => ({ ...p, days: e.target.value }))} required />
                      <input type="date" value={leaveForm.startDate} onChange={e => setLeaveForm(p => ({ ...p, startDate: e.target.value }))} />
                      <input placeholder="ßê¥ßè¡ßèòßï½ßë╡" value={leaveForm.reason} onChange={e => setLeaveForm(p => ({ ...p, reason: e.target.value }))} style={{ gridColumn: "1/-1" }} />
                      {leaveForm.leaveType === "annual" && (
                        <p style={{ gridColumn: "1/-1", margin: 0, fontSize: 13, color: remaining < 5 ? "#ef4444" : "#16a34a", fontWeight: 700 }}>
