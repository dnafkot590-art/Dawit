                  ["announcements", "≡ƒôó ßê¢ßê╡ßë│ßïêßëéßï½"],
                  ["resignations", `≡ƒô¥ ßê╡ßê½ ßêÿßêìßëÇßëâ${pendingResignations > 0 ? ` (${pendingResignations})` : ""}`],
                  ["settings", "ΓÜÖ∩╕Å ßêÿßë╝ßë╢ßë╜"],
