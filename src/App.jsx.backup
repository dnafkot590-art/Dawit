                    {/* Admin ΓåÆ Employee messages */}
                    <div style={{ marginBottom: 20 }}>
                      <h4 style={{ fontSize: 14, margin: "0 0 8px" }}>≡ƒôÑ ßè¿ Admin ßï¿ßë░ßêïßè⌐</h4>
                      {(db.messages || []).filter(m => m.from === "admin" && m.to === String(emp.id)).length === 0
                        ? <p style={{ color: "#94a3b8", fontSize: 13 }}>ßê¥ßèòßê¥ ßêÿßêìßïòßè¡ßë╡ ßï¿ßêêßê¥ßìó</p>
                        : <div className="msg-list">
                          {(db.messages || []).filter(m => m.from === "admin" && m.to === String(emp.id)).map(m => (
