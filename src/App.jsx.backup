                        </button>
                      </form>
                    )}
                    {/* History */}
                    {(db.resignations || []).filter(r => r.empId === emp.id).length > 0 && (
                      <div style={{ marginTop: 16 }}>
                        <h4 style={{ fontSize: 14, margin: "0 0 8px" }}>ßï¿ßëÇßï░ßêÖ ßîÑßï½ßëäßïÄßë╜</h4>
                        <table className="report-table">
                          <thead><tr><th>ßê¥ßè¡ßèòßï½ßë╡</th><th>ßï¿ßêÿßî¿ßê¿ßê╗ ßëÇßèò</th><th>ßêüßèößë│</th></tr></thead>
                          <tbody>
