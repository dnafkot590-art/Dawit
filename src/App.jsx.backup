                                    {calc.card > 0 && <div className="dw-brow"><span>ßè½ßê¡ßï╡ ({f.cardCount} ├ù {Number(f.cardPrice).toLocaleString()})</span><strong>{calc.card.toLocaleString()} Birr</strong></div>}
                                    {calc.lab > 0 && <div className="dw-brow"><span>ßêïßëÑßê½ßë╢ßê¬</span><strong>{calc.lab.toLocaleString()} Birr</strong></div>}
                                    {calc.imaging > 0 && <div className="dw-brow"><span>ßèóßê£ßîéßèòßîì ({f.imagingCount} ├ù {Number(f.imagingPrice).toLocaleString()})</span><strong>{calc.imaging.toLocaleString()} Birr</strong></div>}
                                    {calc.duty > 0 && <div className="dw-brow"><span>ßï▓ßïìßë▓</span><strong>{calc.duty.toLocaleString()} Birr</strong></div>}
                                    {calc.procedure > 0 && <div className="dw-brow"><span>ßìòßê«ßê▓ßîÇßê¡</span><strong>{calc.procedure.toLocaleString()} Birr</strong></div>}
                                    {calc.round > 0 && <div className="dw-brow"><span>ßê½ßïìßèòßï╡</span><strong>{calc.round.toLocaleString()} Birr</strong></div>}
                                    <div className="dw-brow dw-brow-total"><span>ßîáßëàßêïßêï ßîêßëó</span><strong>{calc.total.toLocaleString()} Birr</strong></div>
