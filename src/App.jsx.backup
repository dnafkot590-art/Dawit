                  <div className="card">
                    <h3>≡ƒùô∩╕Å ßììßëâßï╡ ßîÑßï½ßëä ßê¥ßï¥ßîêßëú (Admin)</h3>
                    <form className="form-grid" onSubmit={submitLeaveRequest}>
                      <select value={leaveForm.empId} onChange={e => setLeaveForm(p => ({ ...p, empId: e.target.value }))} required>
