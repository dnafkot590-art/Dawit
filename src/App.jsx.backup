                              placeholder="ßêÿßêìßïòßè¡ßë╡ ßï¡ßî╗ßìë..." value={threadReply} onChange={e => setThreadReply(e.target.value)} />
                            <button className="btn" type="submit" style={{ marginTop: 0, padding: "9px 18px" }}>ßêïßè¡</button>
