                          <div className="payroll-total-row"><span>ßîáßëàßêïßêï ßï░ßê₧ßï¥</span><strong>{(db.employees || []).reduce((s, e) => s + (e.basicSalary || 0), 0).toLocaleString()} Birr</strong></div>
                          <div className="payroll-total-row pension-row"><span>ßîíßê¿ßë│ ßëàßèôßê╜</span><strong>-{(db.employees || []).reduce((s, e) => s + (e.pension || 0), 0).toFixed(0)} Birr</strong></div>
                          <div className="payroll-total-row net-row"><span>ßîáßëàßêïßêï ßï¿ßêÜßè¿ßìêßêì</span><strong>{(db.employees || []).reduce((s, e) => s + (e.netPay || e.basicSalary || 0), 0).toFixed(0)} Birr</strong></div>
                        </div>
