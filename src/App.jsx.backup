                        </div>
                        <button className="btn" style={{ marginTop: 0 }} onClick={addDebt}>Save Debt</button>
                        <h4 style={{ margin: "14px 0 8px" }}>ßï¿ßèÑßï│ ßï¥ßê¡ßï¥ßê¡</h4>
                        <table className="report-table">
                          <thead><tr><th>Organization</th><th>Total</th><th>Paid</th><th>Remaining</th><th>Status</th><th>ßï╡ßê¡ßîèßë╡</th></tr></thead>
                          <tbody>
                            {db.debts.map(d => (
                              <tr key={d.id}>
                                <td>{d.organization}</td>
                                <td>{d.total.toLocaleString()}</td>
                                <td style={{ color: "#16a34a" }}>{d.paid.toLocaleString()}</td>
                                <td style={{ color: "#ef4444", fontWeight: 700 }}>{(d.total - d.paid).toLocaleString()}</td>
                                <td><span className={`status-badge ${d.status === "Paid" ? "approved" : d.status === "Partial" ? "pending" : "rejected"}`}>{d.status}</span></td>
                                <td>
                                  <button className="btn-danger btn-sm" onClick={() => deleteDebt(d.id)}>≡ƒùæ∩╕Å ßê░ßê¡ßï¥</button>
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}

                    {/* Payroll */}
                    {financeTab === "payroll" && (
                      <div>
                        <h4 style={{ margin: "0 0 10px" }}>ßìößê«ßêì ΓÇö ßï░ßê₧ßï¥ ßè¿ßììßï½</h4>
                        <div className="form-grid" style={{ marginBottom: 12 }}>
                          <select value={payrollBankId} onChange={e => setPayrollBankId(e.target.value)}>
                            <option value="">ßëúßèòßè¡ ßê¥ßê¿ßîÑ</option>
                            {(db.bankAccounts || []).map(b => <option key={b.id} value={b.id}>{b.name}</option>)}
                          </select>
                          <input type="date" value={payrollDate} onChange={e => setPayrollDate(e.target.value)} />
                        </div>
                        {(db.employees || []).length > 0 && (
                          <div className="payroll-totals">
                            <div className="payroll-total-row"><span>ßê░ßê½ßë░ßè₧ßë╜</span><strong>{(db.employees || []).length}</strong></div>
                            <div className="payroll-total-row pension-row"><span>ßîíßê¿ßë│</span><strong>-{(db.employees || []).reduce((s, e) => s + e.pension, 0).toFixed(0)} Birr</strong></div>
                            <div className="payroll-total-row net-row"><span>ßîáßëàßêïßêï ßï¿ßêÜßè¿ßìêßêì</span><strong>{(db.employees || []).reduce((s, e) => s + e.netPay, 0).toFixed(0)} Birr</strong></div>
                          </div>
                        )}
                        <div style={{ display: "flex", gap: 10, marginTop: 12 }}>
                          <button className="btn" style={{ flex: 1 }} onClick={payAllSalaries}>Γ£à ßï░ßèò ΓÇö ßïêßî¬ ßê¥ßï¥ßîìßëÑ</button>
                          <button className="secondary-btn" style={{ flex: 1 }} onClick={exportPayroll}>≡ƒôÑ Excel</button>
                        </div>

                        {/* Per-employee payroll edit */}
                        {(db.employees || []).length > 0 && (
                          <div style={{ marginTop: 16 }}>
                            <h4 style={{ fontSize: 14, margin: "0 0 10px" }}>≡ƒÆ╝ ßï▓ßïìßë▓ ßèÑßèô ßï░ßê₧ßï¥ ßê¢ßê╡ßë░ßè½ßè¿ßï½</h4>
                            <table className="report-table">
                              <thead>
                                <tr><th>ßê╡ßê¥</th><th>ßï░ßê₧ßï¥</th><th>ßï▓ßïìßë▓</th><th>7% ßîíßê¿ßë│</th><th>ßï¿ßêÜßè¿ßìêßêì</th><th>ßèáßê¡ßë╡ßïò</th></tr>
                              </thead>
                              <tbody>
                                {(db.employees || []).map(e2 => {
                                  const ed = payrollEdit[e2.id] || {};
                                  const editing = e2.id in payrollEdit;
                                  const curSal = editing ? (ed.basicSalary ?? e2.basicSalary) : e2.basicSalary;
                                  const curDuty = editing ? (ed.duty ?? (e2.duty || 0)) : (e2.duty || 0);
                                  const curPen = editing ? (ed.pensionOpt ?? e2.pensionOpt) : e2.pensionOpt;
                                  const previewPen = curPen ? (Number(curSal) * 0.07).toFixed(0) : 0;
                                  const previewNet = (Number(curSal) * (curPen ? 0.93 : 1) + Number(curDuty)).toFixed(0);
                                  return (
                                    <tr key={e2.id}>
                                      <td>{e2.name}</td>
                                      <td>{editing
                                        ? <input type="number" className="leave-input" style={{ width: 80 }} value={ed.basicSalary ?? e2.basicSalary}
                                          onChange={ev => setPayrollEdit(p => ({ ...p, [e2.id]: { ...p[e2.id], basicSalary: ev.target.value } }))} />
                                        : `${(e2.basicSalary || 0).toLocaleString()}`}
                                      </td>
                                      <td>{editing
                                        ? <input type="number" className="leave-input" style={{ width: 70 }} value={ed.duty ?? (e2.duty || 0)}
                                          onChange={ev => setPayrollEdit(p => ({ ...p, [e2.id]: { ...p[e2.id], duty: ev.target.value } }))} />
                                        : `${(e2.duty || 0).toLocaleString()}`}
                                      </td>
                                      <td>{editing
                                        ? <label style={{ display: "flex", alignItems: "center", gap: 4 }}>
                                          <input type="checkbox" checked={ed.pensionOpt ?? e2.pensionOpt}
                                            onChange={ev => setPayrollEdit(p => ({ ...p, [e2.id]: { ...p[e2.id], pensionOpt: ev.target.checked } }))} />
                                          {curPen ? <span style={{ color: "#ef4444" }}>-{previewPen}</span> : "ΓÇö"}
                                        </label>
                                        : (e2.pension > 0 ? <span style={{ color: "#ef4444" }}>-{e2.pension.toFixed(0)}</span> : "ΓÇö")}
                                      </td>
                                      <td style={{ color: "#16a34a", fontWeight: 700 }}>
                                        {editing ? `${previewNet} Birr` : `${(e2.netPay || e2.basicSalary || 0).toFixed(0)} Birr`}
                                      </td>
                                      <td>
                                        {!editing
                                          ? <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 8px", fontSize: 12 }}
                                            onClick={() => setPayrollEdit(p => ({ ...p, [e2.id]: {} }))}>Γ£Å∩╕Å</button>
                                          : <div style={{ display: "flex", gap: 4 }}>
                                            <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 8px", fontSize: 12, background: "#16a34a" }}
                                              onClick={() => savePayrollEdit(e2.id)}>≡ƒÆ╛</button>
                                            <button className="btn-danger btn-sm"
                                              onClick={() => setPayrollEdit(p => { const n = { ...p }; delete n[e2.id]; return n; })}>Γ£ò</button>
                                          </div>
                                        }
                                      </td>
                                    </tr>
                                  );
                                })}
                              </tbody>
                            </table>
                          </div>
                        )}
                      </div>
                    )}

                    {/* ---- DOCTOR WEEKLY CALCULATOR (Finance portal) ---- */}
                    {financeTab === "payroll" && (db.employees || []).some(e => e.department === "Doctor") && (
                      <div style={{ marginTop: 16, border: "2px solid #dbeafe", borderRadius: 14, padding: 20, background: "#f8fafc" }}>
                        <h4 style={{ margin: "0 0 4px", fontSize: 16, color: "#1e3a5f" }}>≡ƒ⌐║ ßï¿ßï╢ßè¡ßë░ßê«ßë╜ ßê│ßê¥ßèòßë│ßïè ßè¡ßììßï½ ßêéßê│ßëÑ</h4>
                        <p style={{ color: "#64748b", fontSize: 13, margin: "0 0 16px" }}>
                          ßêêßï╢ßè¡ßë░ßê¡ ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡ ßëÑßë╗ ΓÇö ßîáßëàßêïßêï ßîêßëó ßè½ßê░ßêë <strong>15%</strong> ßêêßï╢ßè¡ßë░ßê⌐ ßï¡ßê░ßîúßêìßìó
                        </p>
                        <div style={{ display: "flex", flexDirection: "column", gap: 24 }}>
                          {(db.employees || []).filter(e => e.department === "Doctor").map(emp => {
                            const f = getDoctorForm(emp.id);
                            const calc = calcDoctorWeekly(emp.id);
                            const history = (doctorWeeklyHistory[String(emp.id)] || []);
                            return (
                              <div key={emp.id} className="doctor-weekly-card">
