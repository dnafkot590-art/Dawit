                        {(db.employees || []).map(e => <option key={e.id} value={e.id}>{e.name} ΓÇö {e.department}</option>)}
                      </select>
                      <select value={leaveForm.leaveType} onChange={e => setLeaveForm(p => ({ ...p, leaveType: e.target.value }))}>
                        <option value="annual">≡ƒùô∩╕Å ßïôßêÿßë│ßïè ßììßëâßï╡</option>
                        <option value="emergency">≡ƒÜ¿ ßï╡ßèòßîêßë░ßè¢ ßììßëâßï╡</option>
                      </select>
                      <input type="number" placeholder="ßëÇßèôßë╡ ßëÑßï¢ßë╡" value={leaveForm.days} onChange={e => setLeaveForm(p => ({ ...p, days: e.target.value }))} required />
                      <input type="date" value={leaveForm.startDate} onChange={e => setLeaveForm(p => ({ ...p, startDate: e.target.value }))} />
                      <input placeholder="ßê¥ßè¡ßèòßï½ßë╡" value={leaveForm.reason} onChange={e => setLeaveForm(p => ({ ...p, reason: e.target.value }))} style={{ gridColumn: "1/-1" }} />
                      <button className="btn" type="submit" style={{ gridColumn: "1/-1", marginTop: 0 }}>ßììßëâßï╡ ßîÑßï½ßëä ßê¥ßï¥ßîìßëÑ</button>
                    </form>

                    {/* Leave balance per employee */}
                    <h4 style={{ margin: "18px 0 10px", fontSize: 14 }}>ßï¿ßê░ßê½ßë░ßè₧ßë╜ ßììßëâßï╡ ßëúßêïßèòßê╡</h4>
                    <table className="report-table">
                      <thead><tr><th>ßê╡ßê¥</th><th>ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡</th><th>ßîáßëàßêïßêï</th><th>ßï¿ßïêßê░ßï▒</th><th>ßï¿ßëÇßê¿</th></tr></thead>
                      <tbody>
                        {(db.employees || []).length === 0 ? (
