                      <button className="btn" type="submit" style={{ gridColumn: "1/-1", marginTop: 0 }}>ßììßëâßï╡ ßîáßï¡ßëà</button>
                    </form>
                    {/* my leave history */}
                    {(db.leaveRequests || []).filter(r => r.empId === emp.id).length > 0 && (
                      <table className="report-table" style={{ marginTop: 10 }}>
