                                <td>{e.usedLeaveDays || 0}</td>
                                <td style={{ color: rem < 3 ? "#ef4444" : "#16a34a", fontWeight: 700 }}>{rem}{rem < 3 ? " ΓÜá∩╕Å" : ""}</td>
                              </tr>
                            );
                          })
                        )}
                      </tbody>
                    </table>
                  </div>

                  {/* Pending leave approvals */}
                  <div className="card">
                    <h3>ßììßëâßï╡ ßîÑßï½ßëäßïÄßë╜ {pendingLeave > 0 && <span className="badge">{pendingLeave} Pending</span>}</h3>
                    <table className="report-table">
                      <thead>
                        <tr><th>ßê░ßê½ßë░ßè¢</th><th>ßèáßï¡ßèÉßë╡</th><th>ßëÇßèôßë╡</th><th>ßîÇßê¥ßê«</th><th>ßê¥ßè¡ßèòßï½ßë╡</th><th>ßêüßèößë│</th><th>ßï╡ßê¡ßîèßë╡</th></tr>
                      </thead>
                      <tbody>
                        {(db.leaveRequests || []).length === 0 ? (
                          <tr><td colSpan={7} style={{ textAlign: "center", color: "#94a3b8", padding: 20 }}>ßê¥ßèòßê¥ ßììßëâßï╡ ßîÑßï½ßëä ßèáßêìßëÇßê¿ßëáßê¥ßìó</td></tr>
