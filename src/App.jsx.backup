                  <div className="card">
                    <h3>ßê¢ßê╡ßë│ßïêßëéßï½ ßï¥ßê¡ßï¥ßê¡ ({(db.announcements || []).length})</h3>
                    {(db.announcements || []).length === 0
                      ? <p style={{ color: "#94a3b8", fontSize: 13 }}>ßê¥ßèòßê¥ ßê¢ßê╡ßë│ßïêßëéßï½ ßèáßêìßë░ßêïßè¿ßê¥ßìó</p>
                      : <div className="msg-list">
