              {/* ---- EMPLOYEES TAB ---- */}
              {hrmTab === "employees" && (
                <div className="panel-grid">
                  <div className="card">
                    <h3>ßèáßï▓ßê╡ ßê░ßê½ßë░ßè¢ ßê¥ßï¥ßîêßëú</h3>
                    <form className="form-grid" onSubmit={addEmployee}>
                      <input placeholder="ßêÖßêë ßê╡ßê¥ *" value={empForm.name} onChange={e => setEmpForm(p => ({ ...p, name: e.target.value }))} required />
                      <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
                        <select value={empForm.department} onChange={e => { setEmpForm(p => ({ ...p, department: e.target.value })); if (e.target.value !== "Other") setCustomDept(""); }}>
                          {DEPARTMENTS.map(d => <option key={d}>{d}</option>)}
                        </select>
                        {empForm.department === "Other" && (
                          <input placeholder="ßï▓ßìôßê¡ßë╡ßêÿßèòßë╡ ßê╡ßê¥ ßî╗ßìì *" value={customDept} onChange={e => setCustomDept(e.target.value)} required style={{ padding: "8px 10px", border: "1px solid #2563eb", borderRadius: 8, fontSize: 13 }} />
                        )}
                      </div>
                      <input placeholder="ßê╡ßêìßè¡ ßëüßîÑßê¡" value={empForm.phone} onChange={e => setEmpForm(p => ({ ...p, phone: e.target.value }))} />
                      <input placeholder="ßï¿ßëúßèòßè¡ ßèáßè½ßïìßèòßë╡ ßëüßîÑßê¡" value={empForm.bankAccount} onChange={e => setEmpForm(p => ({ ...p, bankAccount: e.target.value }))} />
                      <input type="date" title="ßï¿ßë░ßëÇßîáßê¿ßëáßë╡ ßëÇßèò" value={empForm.hireDate} onChange={e => setEmpForm(p => ({ ...p, hireDate: e.target.value }))} />
                      <input type="number" placeholder="ßï░ßê₧ßï¥ (Birr) *" value={empForm.basicSalary} onChange={e => setEmpForm(p => ({ ...p, basicSalary: e.target.value }))} required />
