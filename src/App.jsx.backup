                                    : <div style={{ display: "flex", gap: 4 }}>
                                      <button className="btn btn-sm" style={{ marginTop: 0, padding: "4px 8px", fontSize: 12, background: "#16a34a" }} onClick={() => savePayrollEdit(e.id)}>≡ƒÆ╛ ßèáßê╡ßëÇßê¥ßîÑ</button>
                                      <button className="btn-danger btn-sm" onClick={() => setPayrollEdit(p => { const n = { ...p }; delete n[e.id]; return n; })}>Γ£ò</button>
                                    </div>
                                  }
