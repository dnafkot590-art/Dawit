                              <td>{e.bankAccount || "ΓÇö"}</td>
                              <td style={{ color: "#16a34a", fontWeight: 700 }}>{(e.netPay || e.basicSalary).toLocaleString()} Birr</td>
                              <td>{e.hireDate || "ΓÇö"}</td>
                              <td>
                                <button className="btn-danger btn-sm" onClick={() => deleteEmployee(e.id)}>ßê░ßê¡ßï¥</button>
                              </td>
                            </tr>
                          ))
                        )}
                      </tbody>
                    </table>

