                          {(db.employees || []).map(e => <option key={e.id} value={e.id}>{e.name}</option>)}
                        </select>
                        <textarea placeholder="ßêÿßêìßïòßè¡ßë╡..." value={msgForm.body} onChange={e => setMsgForm(p => ({ ...p, body: e.target.value }))}
                          style={{ width: "100%", padding: "6px 8px", borderRadius: 6, border: "1px solid #cbd5e1", minHeight: 60, fontSize: 13, resize: "vertical" }} required />
                        <button className="btn" type="submit" style={{ width: "100%", marginTop: 6 }}>ßêïßè¡ ΓåÆ</button>
                      </form>
