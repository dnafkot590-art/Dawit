                                </div>
                              )}
                            </div>
                            <div style={{ padding: "18px 20px", borderRadius: 14, background: "#0f172a", border: "2px solid #4ade80", textAlign: "center" }}>
                              <div style={{ fontSize: 12, color: "#4ade80", fontWeight: 700, marginBottom: 6 }}>≡ƒÆ░ 15% ΓÇö ßï¿ßèÑßê¡ßê╡ßïÄ ßè¡ßììßï½</div>
                              <div style={{ fontSize: 28, fontWeight: 800, color: "#4ade80" }}>
                                {lastEntry ? Number(lastEntry.doctorCut).toLocaleString() : "ΓÇö"}
                              </div>
                              <div style={{ fontSize: 11, color: "#86efac", marginTop: 3 }}>
                                {lastEntry ? "Birr" : "Admin approval ßï¡ßîáßëÑßëü"}
                              </div>
                              {approvedHistory.length > 1 && (
                                <div style={{ fontSize: 11, color: "#86efac", marginTop: 4 }}>
                                  ßîáßëàßêïßêï: {totalCutAllTime.toLocaleString()} Birr
                                </div>
                              )}
                            </div>
                          </div>

                          {approvedHistory.length > 0 && (
                            <div style={{ marginTop: 12 }}>
                              <table className="report-table" style={{ fontSize: 13 }}>
                                <thead>
                                  <tr>
                                    <th>ßëÇßèò</th>
                                    <th style={{ textAlign: "right" }}>ßîáßëàßêïßêï ßîêßëó</th>
                                    <th style={{ textAlign: "right", color: "#16a34a" }}>15% ßè¡ßììßï½</th>
                                  </tr>
                                </thead>
