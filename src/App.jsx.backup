                        <tbody>
                          {(db.employees || []).length === 0 ? (
                            <tr><td colSpan={6} style={{ textAlign: "center", color: "#94a3b8", padding: 20 }}>ßê¥ßèòßê¥ ßê░ßê½ßë░ßè¢ ßï¿ßêêßê¥ßìó</td></tr>
                          ) : (
